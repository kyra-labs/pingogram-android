# Perfetto config for the measure-first sections (docs/PERFORMANCE.md §9, "Measure first"), as
# tools/perfetto/measure-first.sh (or measure-first.ps1) records them while you use the app: the app's sections
# passcodeHash (one PBKDF2 hash of the passcode lock), speechPcm (one chunk of a voice note resampled for
# transcription) and qrDecode (one camera frame or picked image searched for a QR code), with the scheduling and CPU
# frequencies, so a summary says how long each took and on which thread. Nothing in it reads messages, names or the
# passcode. The script replaces duration_ms with the time you ask for. summarize.py with measure-first.sql turns the
# trace into a text summary.

buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 4096
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      atrace_apps: "dev.kyralabs.pingogram"
      buffer_size_kb: 8192
      drain_period_ms: 250
    }
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}

data_sources {
  config {
    name: "android.packages_list"
    target_buffer: 1
  }
}

duration_ms: 120000
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 30000
