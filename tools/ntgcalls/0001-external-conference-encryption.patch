+    std::string NTgCalls::init_external_conference(const int64_t chat_id) {
+        const std::lock_guard lock(mutex_);
+        auto conference_call = std::make_shared<instances::ConferenceCall>(*update_thread_);
+        if (exists(chat_id)) {
+            auto* p2p_call = dynamic_cast<instances::P2PCall*>(connections_[chat_id].get());
+            if (!p2p_call) {
+                throw ConnectionError("Connection cannot be initialized more than once.");
+            }
+            RTC_LOG(LS_INFO) << "Migrating P2P call to an external conference call for " << chat_id;
+            conference_call->migrate(p2p_call);
+            p2p_call->stop();
+        }
+        connections_[chat_id] = std::move(conference_call);
+        auto payload = safe_call<instances::ConferenceCall>(connections_[chat_id].get())->init_external(chat_id);
+        setup_listeners(chat_id);
+        return payload;
+    }
+
     void NTgCalls::connect(const int64_t chat_id, const std::string& params, const bool is_presentation) {
         safe_call<instances::GroupCall>(safe_connection(chat_id))->connect(params, is_presentation);
     }
diff --git a/targets/android/app/src/main/java/io/github/pytgcalls/ExternalEncryption.java b/targets/android/app/src/main/java/io/github/pytgcalls/ExternalEncryption.java
new file mode 100644
index 0000000..11ff6ae
--- /dev/null
+++ b/targets/android/app/src/main/java/io/github/pytgcalls/ExternalEncryption.java
@@ -0,0 +1,38 @@
+package io.github.pytgcalls;
+
+/**
+ * Pingogram: the encryption of conference calls started with {@code initExternalConference}, done outside NTgCalls.
+ * NTgCalls calls {@link Handler} on WebRTC's threads for every frame it sends and receives, and waits for the answer;
+ * an empty or null answer drops the frame. Set the handler after the native library is loaded (after the first
+ * {@code new NTgCalls()}).
+ */
+@SuppressWarnings("unused")
+public final class ExternalEncryption {
+    /** Channel 0 is the call's main connection, 1 its screen sharing (the presentation). */
+    public interface Handler {
+        byte[] encrypt(long chatId, int channel, byte[] data, int unencryptedPrefix);
+
+        byte[] decrypt(long chatId, int channel, long userId, byte[] data);
+    }
+
+    private static volatile Handler handler;
+
+    private ExternalEncryption() {}
+
+    public static void setHandler(Handler value) {
+        handler = value;
+        nativeInit();
+    }
+
+    private static byte[] encrypt(long chatId, int channel, byte[] data, int unencryptedPrefix) {
+        Handler current = handler;
+        return current == null ? null : current.encrypt(chatId, channel, data, unencryptedPrefix);
+    }
+
+    private static byte[] decrypt(long chatId, int channel, long userId, byte[] data) {
+        Handler current = handler;
+        return current == null ? null : current.decrypt(chatId, channel, userId, data);
+    }
+
+    private static native void nativeInit();
+}
