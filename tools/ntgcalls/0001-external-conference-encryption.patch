diff --git a/targets/android/app/src/main/jni/external_encryption_jni.cpp b/targets/android/app/src/main/jni/external_encryption_jni.cpp
new file mode 100644
index 0000000..d9c7f3d
--- /dev/null
+++ b/targets/android/app/src/main/jni/external_encryption_jni.cpp
@@ -0,0 +1,68 @@
+//
+// Pingogram: hands a conference call's frames to Java (ExternalEncryption), which has TDLib encrypt and decrypt them.
+//
+
+#include <jni.h>
+#include <ntgcalls/instances/external_encryptor.hpp>
+#include <wrtc/utils/java_context.hpp>
+
+namespace {
+    jclass external_class = nullptr;
+    jmethodID encrypt_method = nullptr;
+    jmethodID decrypt_method = nullptr;
+
+    jbyteArray to_java(JNIEnv* env, const bytes::binary& data) {
+        const auto array = env->NewByteArray(static_cast<jsize>(data.size()));
+        if (array) {
+            env->SetByteArrayRegion(array, 0, static_cast<jsize>(data.size()), reinterpret_cast<const jbyte*>(data.data()));
+        }
+        return array;
+    }
+
+    bytes::binary from_java(JNIEnv* env, const jbyteArray array) {
+        if (env->ExceptionCheck()) {
+            env->ExceptionDescribe();
+            env->ExceptionClear();
+            return {};
+        }
+        if (!array) {
+            return {};
+        }
+        bytes::binary result(env->GetArrayLength(array));
+        env->GetByteArrayRegion(array, 0, static_cast<jsize>(result.size()), reinterpret_cast<jbyte*>(result.data()));
+        env->DeleteLocalRef(array);
+        return result;
+    }
+}
+
+extern "C" JNIEXPORT void JNICALL Java_io_github_pytgcalls_ExternalEncryption_nativeInit(JNIEnv* env, jclass clazz) {
+    if (external_class) {
+        return;
+    }
+    // Looked up here, on a Java thread: WebRTC's threads see only the system class loader.
+    external_class = static_cast<jclass>(env->NewGlobalRef(clazz));
+    encrypt_method = env->GetStaticMethodID(external_class, "encrypt", "(JI[BI)[B");
+    decrypt_method = env->GetStaticMethodID(external_class, "decrypt", "(JIJ[B)[B");
+    ntgcalls::instances::ExternalEncryptor::set_handlers(
+        [](const int64_t chat_id, const int channel, const bytes::binary& data, const size_t unencrypted_prefix) {
+            const auto env = static_cast<JNIEnv*>(wrtc::utils::get_jni_env());
+            const auto input = to_java(env, data);
+            const auto output = static_cast<jbyteArray>(env->CallStaticObjectMethod(
+                external_class, encrypt_method, static_cast<jlong>(chat_id), static_cast<jint>(channel), input,
+                static_cast<jint>(unencrypted_prefix)
+            ));
+            env->DeleteLocalRef(input);
+            return from_java(env, output);
+        },
+        [](const int64_t chat_id, const int channel, const int64_t user_id, const bytes::binary& data) {
+            const auto env = static_cast<JNIEnv*>(wrtc::utils::get_jni_env());
+            const auto input = to_java(env, data);
+            const auto output = static_cast<jbyteArray>(env->CallStaticObjectMethod(
+                external_class, decrypt_method, static_cast<jlong>(chat_id), static_cast<jint>(channel),
+                static_cast<jlong>(user_id), input
+            ));
+            env->DeleteLocalRef(input);
+            return from_java(env, output);
+        }
+    );
+}
