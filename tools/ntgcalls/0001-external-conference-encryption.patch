@@ -0,0 +1,38 @@
+//
+// Pingogram: an encryptor whose work is done outside NTgCalls (TDLib).
+//
+
+#include <mutex>
+#include <ntgcalls/instances/external_encryptor.hpp>
+
+namespace ntgcalls::instances {
+    namespace {
+        std::mutex handlers_mutex;
+        ExternalEncryptor::EncryptHandler encrypt_handler;
+        ExternalEncryptor::DecryptHandler decrypt_handler;
+    }
+
+    void ExternalEncryptor::set_handlers(EncryptHandler encrypt, DecryptHandler decrypt) {
+        const std::lock_guard lock(handlers_mutex);
+        encrypt_handler = std::move(encrypt);
+        decrypt_handler = std::move(decrypt);
+    }
+
+    bytes::binary ExternalEncryptor::encrypt(const bytes::binary& data, const size_t unencrypted_prefix) {
+        EncryptHandler handler;
+        {
+            const std::lock_guard lock(handlers_mutex);
+            handler = encrypt_handler;
+        }
+        return handler ? handler(chat_id_, channel_, data, unencrypted_prefix) : bytes::binary();
+    }
+
+    bytes::binary ExternalEncryptor::decrypt(const int64_t user_id, const bytes::binary& data) {
+        DecryptHandler handler;
+        {
+            const std::lock_guard lock(handlers_mutex);
+            handler = decrypt_handler;
+        }
+        return handler ? handler(chat_id_, channel_, user_id, data) : bytes::binary();
+    }
+} // ntgcalls::instances
