@@ -0,0 +1,30 @@
+//
+// Pingogram: an encryptor whose work is done outside NTgCalls (TDLib), for conference calls that TDLib runs.
+//
+
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <wrtc/interfaces/media/e2e_encryptor.hpp>
+
+namespace ntgcalls::instances {
+    class ExternalEncryptor final: public wrtc::interfaces::media::E2EEncryptor {
+        int64_t chat_id_;
+        int channel_;
+
+    public:
+        using EncryptHandler = std::function<bytes::binary(int64_t chat_id, int channel, const bytes::binary& data, size_t unencrypted_prefix)>;
+        using DecryptHandler = std::function<bytes::binary(int64_t chat_id, int channel, int64_t user_id, const bytes::binary& data)>;
+
+        // Set once by the binding (the JNI layer), before any conference call starts. Called on WebRTC's threads; an
+        // empty result drops the frame.
+        static void set_handlers(EncryptHandler encrypt, DecryptHandler decrypt);
+
+        ExternalEncryptor(int64_t chat_id, int channel): chat_id_(chat_id), channel_(channel) {}
+
+        bytes::binary encrypt(const bytes::binary& data, size_t unencrypted_prefix) override;
+
+        bytes::binary decrypt(int64_t user_id, const bytes::binary& data) override;
+    };
+} // ntgcalls::instances
