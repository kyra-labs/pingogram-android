<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TDLib's connection to Telegram's data centers. Every permission needs the owner's approval
         (CLAUDE.md) and is pinned by AppManifestTest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications of new messages (REQUIREMENTS.md FR-N1, approved by the owner on 2026-10-19). Android 13 and
         later ask the user at run time: the chat list explains why first, and asks once. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Unlocking the passcode lock with a fingerprint or the face through the system's BiometricPrompt, Android 10
         and later (REQUIREMENTS.md FR-S1, approved by the owner on 2026-10-20). A normal permission: Android grants it
         at install, and the system's prompt asks the user each time. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Recording voice messages in the composer (REQUIREMENTS.md FR-C5, approved by the owner on 2026-10-20), only
         while the conversation is on screen. Asked at run time at the first hold of the microphone, after a snackbar
         says why. Devices without a microphone can still install the app (and do everything else). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- WorkManager (notification actions, transfers) declares these four. It needs WAKE_LOCK only before Android 12,
         where expedited work runs as a foreground service that holds a wake lock while a reply is sent (approved by
         the owner on 2026-10-19), so it stops at API 30. FOREGROUND_SERVICE on every version: the files the user
         sends and downloads continue in the background in WorkManager's foreground service (REQUIREMENTS.md FR-N4,
         TransfersWorker, approved by the owner on 2026-10-20), with its type dataSync on Android 14+
         (FOREGROUND_SERVICE_DATA_SYNC). It runs only while such a transfer is on its way, never for automatic
         downloads. ACCESS_NETWORK_STATE is declared below for Pingogram's own use. RECEIVE_BOOT_COMPLETED only
         reschedules work after a reboot, which its short-lived work does not need: it is left out. The foss flavor's
         manifest declares RECEIVE_BOOT_COMPLETED for its "Keep connected" service (src/foss/AndroidManifest.xml).
         Media3 ExoPlayer (feature:chat) declares ACCESS_NETWORK_STATE and WAKE_LOCK too; it plays only files TDLib
         downloaded and sets no wake mode. Calls hold WAKE_LOCK on every version (approved by the owner for calls on
         2026-10-22): the proximity wake lock turns the screen off while the phone is at the ear during a call, and
         only then (feature:calls CallService). -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="replace" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 16 promotes the transfers' progress notification to a Live Update (status bar chip, lock screen) only
         for apps that hold it (approved by the owner on 2026-10-21; docs/adr/0009-background-transfers.md). A normal
         permission, granted at install; the user can still turn Live Updates off for Pingogram in Android's settings. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Which network the device uses (Wi-Fi, mobile data, roaming) and whether it is metered, read from
         ConnectivityManager's default network callback (approved by the owner on 2026-10-20): automatic download
         follows the rules of the current network (Settings → Data and storage, docs/PERFORMANCE.md §7), and TDLib is
         told of every new network (setNetworkType), so it reconnects at once. A normal permission, granted at install;
         nothing is sent anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <!-- Saving a photo or video from the media viewer into the gallery on Android 8–9 (approved by the owner on
         2026-10-18), asked for at run time when first needed. Android 10 and later save through MediaStore
         without any permission, so it is not requested there. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Contacts sync, opt-in and off by default (REQUIREMENTS.md FR-P1, approved by the owner on 2026-10-21,
         docs/adr/0011-contacts-sync.md): its only use. Asked at run time after the Contacts tab or Settings explains
         that the names and phone numbers of the phone's contacts go to Telegram, which finds who uses it. Read only
         when the user turns sync on, opens Contacts while it is on, or taps Sync now; never in the background. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Sending the device's location from the attach menu (REQUIREMENTS.md FR-C5, approved by the owner on 2026-10-20),
         in the foreground only, while its sheet is open: there is no background location permission and no live
         location. The sheet explains why before Android asks; both are asked together, so Android 12 and later let the
         user pick an approximate location, which is then what is sent. The platform's LocationManager finds it, no
         Google Play services (docs/adr/0006-platform-location-manager.md). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Devices without GPS (Chromebooks, some tablets) still install Pingogram, and find their location through the
         network provider, or say they cannot. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <!-- The in-app QR code scanner (REQUIREMENTS.md FR-P5, approved by the owner on 2026-10-21,
         docs/adr/0012-camerax-and-zxing-qr-scanner.md): asked at run time when the scanner opens, after it says why.
         Frames are read for QR codes on the device by ZXing while the scanner shows, and dropped; nothing the camera
         sees is kept or sent, only the text of a Telegram link reaches TDLib. And video calls (FR-V2, approved for 1:1
         video, docs/adr/0019-video-and-group-calls-scope.md): asked when the user turns the camera on in a call; the
         video goes to the other person only, end-to-end encrypted, and is not kept. Devices without a camera still install
         Pingogram and scan from an image (the photo picker, no permission). The CAMERA permission implies a required
         back camera with autofocus, so those are declared optional too. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Calls (REQUIREMENTS.md FR-V1, docs/adr/0018-calls-and-telecom.md), approved by the owner for calls only on
         2026-10-22. RECORD_AUDIO above is asked for again before the first call or answer, after the call screen says
         why. MANAGE_OWN_CALLS: Pingogram is a self-managed calling app in Android's Telecom, so the system UI,
         Bluetooth headsets, cars and watches know its calls, and a phone call puts one on hold. The call's foreground
         service runs as phoneCall while a call rings or goes on, as microphone too once the user talks, and as camera
         while the user's camera sends video (FOREGROUND_SERVICE_PHONE_CALL, FOREGROUND_SERVICE_MICROPHONE,
         FOREGROUND_SERVICE_CAMERA). USE_FULL_SCREEN_INTENT shows an incoming call
         over the lock screen; Android 14+ lets the user take it back, and the call then rings as a heads-up
         notification. BLUETOOTH_CONNECT (Android 12+, asked with the microphone) names Bluetooth headsets the call can
         move to. MODIFY_AUDIO_SETTINGS sets the call's audio mode and route where the device has no Telecom. Telecom's
         Jetpack library declares BLUETOOTH_CONNECT, MANAGE_OWN_CALLS and MODIFY_AUDIO_SETTINGS too. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Self-managed calls need the system's Telecom; devices without it still install Pingogram and call without it. -->
    <uses-feature
        android:name="android.software.telecom"
        android:required="false" />

    <!-- enableOnBackInvokedCallback: predictive back (REQUIREMENTS.md §7). localeConfig: the languages Android 13 and
         later offer in the app's language settings (REQUIREMENTS.md §7, per-app language). networkSecurityConfig: no
         cleartext traffic, on Android 8 too (REQUIREMENTS.md §6.2). -->
    <application
        android:name=".PingogramApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pingogram.Starting"
        tools:targetApi="tiramisu">

        <!-- singleTask: a Telegram link from another app opens in Pingogram's own task, through onNewIntent when it runs,
             not in a second copy of the app inside the other app's task (docs/adr/0013-deep-links.md). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Telegram's app links, tg://resolve?domain=… and the like, which only Telegram clients open. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tg" />
            </intent-filter>
            <!-- Telegram's web links, t.me/username and the like. Not verified as App Links (autoVerify false): only
                 Telegram can publish the assetlinks.json of its domains, so from Android 12 on these open in the
                 browser unless the user lets Pingogram open them ("Open supported links" in Android's settings for the
                 app; Settings → About → Open Telegram links). TDLib reads the link (getInternalLinkType). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="t.me" />
                <data android:host="*.t.me" />
                <data android:host="telegram.me" />
                <data android:host="telegram.dog" />
            </intent-filter>
            <!-- Direct share (REQUIREMENTS.md FR-N2): text, links, photos, videos and any files other apps share,
                 one or several. No permission: shared content:// URIs are read with the grant they come with, once the
                 user picked a chat, and copied into the upload cache like attachments; nothing is sent before the user
                 taps send. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- The share target of the conversation shortcuts, which makes the system's share sheet list recent chats
                 (Direct Share targets, Android 11+; core:notifications ConversationShortcuts). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The call screen (feature:calls) on the app's window theme, without the launch theme's splash screen. -->
        <activity
            android:name="dev.kyralabs.pingogram.feature.calls.ui.CallActivity"
            android:theme="@style/Theme.Pingogram"
            tools:node="merge" />
        <!-- The home screen widget of recent chats (docs/adr/0017-home-screen-widget.md). Exported for the system's
             widget updates; it takes nothing else. -->
        <receiver
            android:name=".widget.RecentChatsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recent_chats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_chats_widget_info" />
        </receiver>

        <!-- WorkManager starts when first used (PingogramApplication's Configuration.Provider, with Hilt's worker
             factory), not at every process start through App Startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Hands TDLib's downloaded files to the app the user picks, with a read grant for one URI at a time:
             sharing from the media viewer, opening documents (approved by the owner on 2026-10-18); and to the
             camera app the file it writes a photo into for the attach menu, with a write grant. Only the
             directories in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
