<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TDLib's connection to Telegram's data centers. Every permission needs the owner's approval
         (CLAUDE.md) and is pinned by AppManifestTest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Media3 ExoPlayer (feature:chat) declares these for streaming and wake locks. Pingogram plays only files
         TDLib downloaded and sets no wake mode, and ExoPlayer handles the missing network permission, so they are
         left out. A dependency that needs one (WorkManager needs WAKE_LOCK) must drop its line here, with the owner's
         approval. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />
    <!-- Saving a photo or video from the media viewer into the gallery on Android 8–9 (approved by the owner on
         2026-10-18), asked for at run time when first needed. Android 10 and later save through MediaStore
         without any permission, so it is not requested there. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- enableOnBackInvokedCallback: predictive back (REQUIREMENTS.md §7). -->
    <application
        android:name=".PingogramApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pingogram.Starting"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands TDLib's downloaded files to the app the user picks, with a read grant for one URI at a time:
             sharing from the media viewer, opening documents (approved by the owner on 2026-10-18); and to the
             camera app the file it writes a photo into for the attach menu, with a write grant. Only the
             directories in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
