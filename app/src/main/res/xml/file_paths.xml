<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider in AndroidManifest.xml may hand to other apps: TDLib's downloaded files
     (filesDir/tdlib/files, filesDir/tdlib-test/files on the test DC; core:tdlib TdlibDirectories), shared from
     the media viewer and opened from the conversation. Never TDLib's database (filesDir/tdlib/db) or anything
     else. Keep in sync with core:ui TdlibFiles.kt, which refuses other paths first. -->
<paths>
    <files-path
        name="tdlib"
        path="tdlib/files/" />
    <files-path
        name="tdlib-test"
        path="tdlib-test/files/" />
</paths>
