<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget's unread badge: a full pill, tinted by the widget with its theme role. A drawable rather
     than Glance's cornerRadius, which launchers before Android 12 ignore. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="@dimen/widget_pill_radius" />
</shape>
