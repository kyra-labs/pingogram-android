<?xml version="1.0" encoding="utf-8"?>
<!-- An app shortcut's icon (res/xml/shortcuts.xml): adaptive, as the launcher icon, so launchers mask it to their
     shape; the monochrome layer is for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground android:drawable="@drawable/ic_shortcut_new_chat_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_new_chat_foreground" />
</adaptive-icon>
