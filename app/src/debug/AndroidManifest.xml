<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. LeakCanary (docs/PERFORMANCE.md §9) asks for READ_EXTERNAL_STORAGE to read heap dumps it once kept
  in shared storage; it keeps them in the app's own files and works without it, so debug builds ask for no permission
  that release builds do not (AppManifestTest).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
</manifest>
