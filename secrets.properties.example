# Copy to secrets.properties (git-ignored) and fill in from https://my.telegram.org
# Never commit the real file. CI injects these from GitHub Actions secrets.
# The build fails if the file or a key is missing or malformed (see docs/OWNER_SETUP.md).

# api_id: a non-negative integer
TELEGRAM_API_ID=123456
# api_hash: exactly 32 hexadecimal characters
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
