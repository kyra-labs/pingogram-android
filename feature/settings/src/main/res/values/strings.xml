<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_title">Settings</string>
    <!-- Spoken by screen readers for the back button of a settings page. -->
    <string name="settings_back">Back</string>
    <string name="settings_retry">Try again</string>

    <!-- Account header. %1$s is the username, without @. -->
    <string name="settings_account_username">\@%1$s</string>

    <!-- Settings home -->
    <string name="settings_section_general">General</string>
    <string name="settings_appearance">Appearance</string>
    <string name="settings_appearance_summary">Theme, colors and contrast</string>
    <string name="settings_data_storage">Data and storage</string>
    <string name="settings_data_storage_summary">Storage usage, clear cache</string>
    <string name="settings_about">About</string>
    <string name="settings_about_summary">Version, source code, license</string>

    <!-- Account section -->
    <string name="settings_section_account">Account</string>
    <string name="settings_log_out">Log out</string>
    <string name="settings_log_out_summary">Remove this account from Pingogram on this device</string>
    <!-- Spoken by screen readers for the progress indicator while logging out. -->
    <string name="settings_logging_out">Logging out</string>

    <!-- Log out confirmation (FR-A8) -->
    <string name="settings_log_out_dialog_title">Log out?</string>
    <string name="settings_log_out_dialog_text">Pingogram will delete this account\'s data from this device, including secret chats, which exist only here. Your other chats stay in your Telegram account, and you can log in again at any time.</string>
    <string name="settings_log_out_dialog_confirm">Log out</string>
    <string name="settings_log_out_dialog_dismiss">Cancel</string>

    <!-- Appearance (FR-S2) -->
    <!-- Spoken by screen readers for the progress indicator while the settings load. -->
    <string name="settings_appearance_loading">Loading appearance settings</string>
    <string name="settings_section_theme">Theme</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_amoled">AMOLED black</string>
    <string name="settings_amoled_summary">Pure black backgrounds in dark theme</string>
    <string name="settings_section_colors">Colors</string>
    <string name="settings_dynamic_color">Dynamic color</string>
    <string name="settings_dynamic_color_summary">Colors from your wallpaper</string>
    <string name="settings_contrast">Contrast</string>
    <string name="settings_contrast_standard">Standard</string>
    <string name="settings_contrast_medium">Medium</string>
    <string name="settings_contrast_high">High</string>
    <!-- Android 14+, where the system's contrast setting applies to every app. -->
    <string name="settings_contrast_follows_system">Follows your device\'s contrast setting</string>
    <!-- Before Android 14, wallpaper colors have no contrast levels. -->
    <string name="settings_contrast_brand_colors">Medium and high contrast use Pingogram\'s colors instead of your wallpaper\'s</string>

    <!-- Data and storage -->
    <string name="settings_section_storage_usage">Storage usage</string>
    <!-- Spoken by screen readers for the progress indicator while the storage usage loads. -->
    <string name="settings_storage_usage_loading">Loading storage usage</string>
    <string name="settings_storage_files">Downloaded files</string>
    <!-- %1$s is a size such as "1.5 GB", %2$s a file count such as "3,456 files". -->
    <string name="settings_storage_files_size">%1$s · %2$s</string>
    <plurals name="settings_storage_file_count">
        <item quantity="one">%1$s file</item>
        <item quantity="other">%1$s files</item>
    </plurals>
    <string name="settings_storage_database">Database</string>
    <!-- %1$s is a size such as "85 MB". -->
    <string name="settings_storage_database_size">%1$s · chats, messages and settings</string>
    <string name="settings_section_cache">Cache</string>
    <string name="settings_clear_cache">Clear cache</string>
    <string name="settings_clear_cache_summary">Remove downloaded photos, videos and files from this device</string>
    <!-- Spoken by screen readers for the progress indicator while the cache is cleared. -->
    <string name="settings_clearing_cache">Clearing cache</string>
    <string name="settings_clear_cache_dialog_title">Clear cache?</string>
    <string name="settings_clear_cache_dialog_text">Downloaded photos, videos, voice messages, music and files will be removed from this device. They stay in your chats and download again when you open them. Secret chats aren\'t affected.</string>
    <string name="settings_clear_cache_dialog_confirm">Clear cache</string>
    <string name="settings_clear_cache_dialog_dismiss">Cancel</string>
    <!-- Snackbar after clearing the cache. %1$s is a size such as "1.5 GB". -->
    <string name="settings_clear_cache_done">Cleared %1$s</string>
    <string name="settings_clear_cache_nothing">There was nothing to clear</string>

    <!-- About -->
    <string name="settings_section_app">App</string>
    <string name="settings_about_app_name">Pingogram</string>
    <!-- %1$s is the version, such as "0.3.0". -->
    <string name="settings_about_version">Version %1$s</string>
    <string name="settings_about_source_code">Source code</string>
    <string name="settings_about_source_code_summary">github.com/kyra-labs/pingogram-android</string>
    <string name="settings_about_license">License</string>
    <string name="settings_about_license_summary">GNU General Public License v3.0 or later</string>
    <string name="settings_about_unofficial">Pingogram is an unofficial Telegram client built on TDLib. It is not affiliated with Telegram.</string>
</resources>
