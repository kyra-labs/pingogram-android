    <string name="sponsored_advertiser">Advertiser</string>
    <!-- Above more information Telegram gives about the ad. -->
    <string name="sponsored_additional_info">More about this ad</string>
    <string name="sponsored_report">Report ad</string>
    <!-- The back button of the report step, for screen readers. -->
    <string name="sponsored_report_back">Back</string>
    <string name="sponsored_reported">Thanks, the ad was reported</string>
    <string name="sponsored_ads_hidden">Sponsored messages are hidden</string>
    <string name="sponsored_premium_required">Only Telegram Premium subscribers can hide ads</string>
    <string name="sponsored_report_failed">The ad couldn\'t be reported</string>
    <!-- Information only: Pingogram never offers or links to Telegram Premium. -->
    <string name="sponsored_premium_note">Telegram Premium subscribers can turn sponsored messages off.</string>
    <string name="sponsored_no_app">No app can open this link</string>
