<?xml version="1.0" encoding="utf-8"?>
<!-- Secret chats in the conversation (REQUIREMENTS.md FR-E1): the header, the composer, the banner at the start, the
     self-destruct timer and the encryption key. The states shared with the chat list are in core:ui. -->
<resources>
    <!-- The lock before a secret chat's name, for screen readers. -->
    <string name="secret_chat">Secret chat</string>

    <!-- In the composer's place while the user cannot write. -->
    <string name="composer_secret_pending">You can send messages once the secret chat is set up</string>
    <string name="composer_secret_closed">This secret chat has ended</string>

    <!-- The banner at the start of a secret chat. %1$s is the other user's name. -->
    <string name="secret_intro_title">End-to-end encrypted</string>
    <string name="secret_intro_encrypted">Only you and %1$s can read these messages.</string>
    <string name="secret_intro_device">They are kept on this device only, not in Telegram\'s cloud, and can\'t be forwarded.</string>
    <string name="secret_intro_timer">Set a self-destruct timer to delete them after they\'re read.</string>
    <string name="secret_intro_screenshots">Pingogram blocks screenshots of this chat on this device.</string>

    <!-- The top bar's actions. %1$s is the timer, e.g. "30 seconds". -->
    <string name="secret_timer_button_off">Self-destruct timer, off</string>
    <string name="secret_timer_button">Self-destruct timer, %1$s</string>
    <string name="secret_key_button">Encryption key</string>

    <!-- The self-destruct timer sheet. -->
    <string name="secret_timer_title">Self-destruct timer</string>
    <string name="secret_timer_body">New messages are deleted on both devices this long after they\'re read.</string>
    <string name="secret_timer_off">Off</string>
    <!-- Short forms on the timer button and in a bubble's time: 30s, 5m, 1h, 1d, 1w. -->
    <string name="secret_timer_short_seconds">%1$ds</string>
    <string name="secret_timer_short_minutes">%1$dm</string>
    <string name="secret_timer_short_hours">%1$dh</string>
    <string name="secret_timer_short_days">%1$dd</string>
    <string name="secret_timer_short_weeks">%1$dw</string>
    <plurals name="secret_timer_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <plurals name="secret_timer_weeks">
        <item quantity="one">%d week</item>
        <item quantity="other">%d weeks</item>
    </plurals>
    <!-- A bubble's self-destruct timer, for screen readers. %1$s is the timer, e.g. "30 seconds". -->
    <string name="chat_bubble_self_destruct">deletes itself %1$s after it\'s read</string>

    <!-- The encryption key sheet. %1$s is the other user's name. -->
    <string name="secret_key_title">Encryption key</string>
    <string name="secret_key_image">Image of the encryption key</string>
    <string name="secret_key_compare">If this image and these characters look the same on %1$s\'s screen, nobody else can read your messages.</string>
    <string name="secret_key_pending">The key shows here once %1$s\'s app has joined the chat.</string>
    <string name="secret_end">End secret chat</string>
    <string name="secret_end_title">End this secret chat?</string>
    <string name="secret_end_body">Neither of you can send messages in it any more. The messages stay on this device until you delete the chat.</string>
    <string name="secret_end_confirm">End chat</string>
    <string name="secret_end_cancel">Cancel</string>
</resources>
