<?xml version="1.0" encoding="utf-8"?>
<!-- Replies and links in the message actions (REQUIREMENTS.md FR-C5, FR-C6): quote replies, replies in another chat,
     message links, and replacing the media of a message being edited. -->
<resources>
    <!-- The message actions. -->
    <string name="message_action_reply_elsewhere">Reply in another chat</string>
    <string name="message_action_copy_link">Copy link</string>
    <string name="message_action_copy_thread_link">Copy link to this thread</string>
    <!-- Before Android 13, which confirms copies itself. -->
    <string name="message_link_copied">Link copied</string>

    <!-- The item the lifted message's text selection offers beside Copy: replies quoting the selected text. -->
    <string name="quote_action">Quote</string>
    <string name="quote_unavailable">Select part of the message\'s text to quote it</string>
    <!-- For screen readers, the quote mark of a reply bar or reply quote that quotes part of the message. -->
    <string name="quote_label">Quote</string>
    <!-- A bubble's description for screen readers: %1$s is the quoted message's sender, %2$s the quoted text. -->
    <string name="chat_bubble_quote">Quoting %1$s: %2$s</string>

    <!-- The reply bar of a reply to a message of another chat: %1$s is its sender, %2$s that chat's title. -->
    <string name="composer_reply_elsewhere">Reply to %1$s in %2$s</string>
    <!-- The same for the user's own message: %1$s is the chat's title. -->
    <string name="composer_reply_elsewhere_own">Reply to your message in %1$s</string>
    <!-- The same while the message loads: %1$s is the chat's title. -->
    <string name="composer_reply_in">Reply in %1$s</string>

    <!-- The sheet that picks the chat to reply in. %1$s is one line of the message replied to. -->
    <string name="reply_chats_title">Reply in another chat</string>
    <string name="reply_chats_message">Replying to: %1$s</string>
    <string name="reply_chats_none">No chats to reply in</string>

    <!-- The edit bar's button that replaces the edited message's photo, video or GIF, or its file or song. -->
    <string name="composer_replace_media">Replace photo or video</string>
    <string name="composer_replace_file">Replace file</string>
    <!-- The attach preview of the replacement. -->
    <string name="attach_replace_title_media">Replace with this</string>
    <string name="attach_replace_title_file">Replace with this file</string>
    <string name="attach_replace_note">The caption stays as you edit it in the message.</string>
    <string name="attach_replace_choose">Choose another</string>
    <string name="attach_replace_confirm">Replace</string>
</resources>
