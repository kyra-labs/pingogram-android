<?xml version="1.0" encoding="utf-8"?>
<!-- Comment threads and replies (REQUIREMENTS.md FR-C9): a message's link to its thread, and the thread's top bar. -->
<resources>
    <!-- Under a channel post: opens its comments. "Leave a comment" when there are none yet. -->
    <string name="thread_comments_none">Leave a comment</string>
    <plurals name="thread_comments">
        <item quantity="one">%d comment</item>
        <item quantity="other">%d comments</item>
    </plurals>
    <!-- Under a group message others replied to in its thread: opens the thread. -->
    <plurals name="thread_replies">
        <item quantity="one">%d reply</item>
        <item quantity="other">%d replies</item>
    </plurals>

    <!-- The bubble's custom action for screen readers: opens the thread. -->
    <string name="thread_open_comments">Open comments</string>
    <string name="thread_open_replies">Open replies</string>

    <!-- The top bar of a thread with no comments or replies yet. -->
    <string name="thread_title_comments">Comments</string>
    <string name="thread_title_replies">Replies</string>
</resources>
