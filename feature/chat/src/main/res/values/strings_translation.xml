<?xml version="1.0" encoding="utf-8"?>
<!-- Message translation (REQUIREMENTS.md FR-C3): a message's actions, its bubble's label, and the translate bar. -->
<resources>
    <!-- The message actions that show a bubble's translation, and its own text again. -->
    <string name="message_action_translate">Translate</string>
    <string name="message_action_show_original">Show original</string>

    <!-- The label in a translated bubble's meta, before its time. %1$s is the language it was translated from. -->
    <string name="translation_from">Translated from %1$s</string>
    <string name="translation_translated">Translated</string>
    <string name="translation_translating">Translating…</string>

    <!-- The translate bar over the messages. %1$s is the language translations go into ("English"). -->
    <string name="translation_bar_translate">Translate to %1$s</string>
    <string name="translation_bar_show_original">Show original</string>
    <!-- Under it, the chat's language as the device detected it. %1$s is that language ("Spanish"). -->
    <string name="translation_bar_from">Chat in %1$s</string>
    <string name="translation_bar_translated">Messages translated by Telegram</string>
    <string name="translation_bar_close">Close translate bar</string>

    <!-- The snackbars. -->
    <string name="translation_failed">Telegram couldn\'t translate this message</string>
    <string name="translation_bar_hidden">Translate bar closed. You can still translate a message from its menu.</string>
</resources>
