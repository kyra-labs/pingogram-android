<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Media and other content in messages (ui/content). The kinds of content ("Photo", "Voice message", "Location")
         are core:ui's preview strings. -->
    <!-- What tapping a photo, a video, a file or a location does, for screen readers. -->
    <string name="content_open">Open</string>
    <!-- Over a video, under a song: %1$s is its length ("1:05"), %2$s its file size ("12 MB"). -->
    <string name="content_duration_and_size">%1$s · %2$s</string>
    <!-- For screen readers: %1$s is what something is ("Video"), %2$s more about it ("1:05 · 12 MB", "Not played yet"). -->
    <string name="content_kind_and_details">%1$s, %2$s</string>
    <!-- How much of a voice message or a song has played ("0:12 / 0:42"), or of a file has downloaded ("1.2 MB / 4.5 MB"). -->
    <string name="content_progress_of">%1$s / %2$s</string>
    <string name="content_play">Play</string>
    <string name="content_pause">Pause</string>
    <!-- For screen readers: nobody has played this voice message or watched this video message yet. -->
    <string name="content_not_played">Not played yet</string>
    <string name="content_download">Download</string>
    <string name="content_cancel_download">Cancel download</string>

    <!-- File sizes in decimal units, as Android shows them: %1$s is the number ("4.5"). -->
    <string name="content_size_bytes">%1$s B</string>
    <string name="content_size_kilobytes">%1$s kB</string>
    <string name="content_size_megabytes">%1$s MB</string>
    <string name="content_size_gigabytes">%1$s GB</string>

    <!-- A location's coordinates: %1$s is the latitude, %2$s the longitude, each with its hemisphere. -->
    <string name="content_coordinates">%1$s, %2$s</string>
    <!-- %1$s is a number of degrees ("52.52001"). -->
    <string name="content_latitude_north">%1$s° N</string>
    <string name="content_latitude_south">%1$s° S</string>
    <string name="content_longitude_east">%1$s° E</string>
    <string name="content_longitude_west">%1$s° W</string>

    <!-- Polls: what kind of poll it is, under its question. In an anonymous poll nobody sees who voted for what. -->
    <string name="content_poll_anonymous">Anonymous poll</string>
    <string name="content_poll_public">Public poll</string>
    <!-- A quiz is a poll with a correct answer. -->
    <string name="content_quiz_anonymous">Anonymous quiz</string>
    <string name="content_quiz_public">Public quiz</string>
    <!-- Instead of the kind of poll, once it is closed. -->
    <string name="content_poll_closed">Final results</string>
    <!-- An answer's share of the votes: %1$d is a percentage. -->
    <string name="content_poll_percentage">%1$d%%</string>
    <!-- For screen readers, the marks next to answers. -->
    <string name="content_poll_chosen">Your answer</string>
    <string name="content_quiz_correct">Correct answer</string>
    <string name="content_quiz_wrong">Wrong answer</string>
    <string name="content_poll_no_votes">No votes yet</string>
    <string name="content_quiz_no_answers">No answers yet</string>
    <!-- %1$s is the number of people who voted, with digits of the user's language. -->
    <plurals name="content_poll_votes">
        <item quantity="one">%1$s vote</item>
        <item quantity="other">%1$s votes</item>
    </plurals>
    <plurals name="content_quiz_answers">
        <item quantity="one">%1$s answer</item>
        <item quantity="other">%1$s answers</item>
    </plurals>
</resources>
