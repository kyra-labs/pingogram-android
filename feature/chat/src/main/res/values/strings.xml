<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Conversation top bar (ChatTopBar) -->
    <string name="chat_back">Back</string>
    <!-- Under a user's name: what Telegram tells about when they were last online. -->
    <string name="chat_subtitle_online">online</string>
    <string name="chat_subtitle_last_seen_just_now">last seen just now</string>
    <plurals name="chat_subtitle_last_seen_minutes">
        <item quantity="one">last seen %d minute ago</item>
        <item quantity="other">last seen %d minutes ago</item>
    </plurals>
    <!-- %1$s is a time of day, "9:41 AM". -->
    <string name="chat_subtitle_last_seen_today">last seen today at %1$s</string>
    <!-- %1$s is a time of day, "9:41 AM". -->
    <string name="chat_subtitle_last_seen_yesterday">last seen yesterday at %1$s</string>
    <!-- %1$s is a date, "Mar 17" or "3/17/2024". -->
    <string name="chat_subtitle_last_seen_date">last seen %1$s</string>
    <!-- The user's privacy settings hide when they were last online; Telegram tells roughly. -->
    <string name="chat_subtitle_last_seen_recently">last seen recently</string>
    <string name="chat_subtitle_last_seen_week">last seen within a week</string>
    <string name="chat_subtitle_last_seen_month">last seen within a month</string>
    <string name="chat_subtitle_last_seen_long_ago">last seen a long time ago</string>
    <string name="chat_subtitle_bot">bot</string>
    <plurals name="chat_subtitle_members">
        <item quantity="one">%,d member</item>
        <item quantity="other">%,d members</item>
    </plurals>
    <plurals name="chat_subtitle_subscribers">
        <item quantity="one">%,d subscriber</item>
        <item quantity="other">%,d subscribers</item>
    </plurals>
    <!-- Under a group's or channel's name while its member count is not known. -->
    <string name="chat_subtitle_group">group</string>
    <string name="chat_subtitle_channel">channel</string>

    <!-- Messages (ChatScreen, MessageBubble) -->
    <string name="chat_date_today">Today</string>
    <string name="chat_date_yesterday">Yesterday</string>
    <!-- Above the first message that was unread when the chat was opened. -->
    <string name="chat_unread_divider">Unread messages</string>
    <!-- Before the time of a message that was edited. -->
    <string name="chat_edited">edited</string>
    <!-- %1$s is who originally sent a forwarded message. -->
    <string name="chat_forwarded_from">Forwarded from %1$s</string>
    <!-- A channel or chat a message was forwarded from (%1$s), with the signature of its author (%2$s). -->
    <string name="chat_forwarded_name_signed">%1$s (%2$s)</string>
    <!-- Reply quotes whose replied message cannot be shown (yet). -->
    <string name="chat_reply_loading">Loading…</string>
    <string name="chat_reply_deleted">Deleted message</string>
    <string name="chat_reply_unavailable">Message unavailable</string>
    <!-- A replied message of another chat, known only by its sender. -->
    <string name="chat_reply_message">Message</string>
    <!-- What tapping a reply quote does, for screen readers: scroll to the message it replies to. -->
    <string name="chat_reply_open">Show replied message</string>
    <!-- A snackbar after tapping a reply quote, or opening search's result, whose message was deleted. -->
    <string name="chat_message_unavailable">The message is no longer available</string>
    <string name="chat_empty_title">No messages here yet</string>
    <string name="chat_empty_body">Messages in this chat show up here.</string>
    <string name="chat_error_title">Messages couldn\'t be loaded</string>
    <string name="chat_not_found_title">Chat not found</string>
    <string name="chat_not_found_body">This chat doesn\'t exist, or you no longer have access to it.</string>
    <string name="chat_retry">Try again</string>
    <!-- Above the oldest loaded message when older ones could not be loaded. -->
    <string name="chat_older_error">Older messages couldn\'t be loaded</string>
    <!-- Below the newest loaded message when newer ones could not be loaded. -->
    <string name="chat_newer_error">Newer messages couldn\'t be loaded</string>
    <string name="chat_jump_to_bottom">Scroll to newest messages</string>
    <!-- The unread count in the badge of the button that scrolls to the newest messages. -->
    <string name="chat_unread_badge">%1$d</string>
    <!-- An unread count above the badge's limit: %1$d is the limit, 999. -->
    <string name="chat_unread_badge_overflow">%1$d+</string>
    <!-- On a bubble's corner after its first reaction badges: %1$d more kinds of reaction. -->
    <string name="chat_reactions_more">+%1$d</string>

    <!-- Screen readers: a message bubble read as one ("Alice, 9:41 AM: Hello, read"). -->
    <!-- %1$s is the sender, %2$s the time, %3$s the content, %4$s the state of an outgoing message. -->
    <string name="chat_bubble_description">%1$s, %2$s: %3$s, %4$s</string>
    <!-- The same for incoming messages: %1$s is the sender, %2$s the time, %3$s the content. -->
    <string name="chat_bubble_description_incoming">%1$s, %2$s: %3$s</string>
    <!-- The time of an edited message: %1$s is the time. -->
    <string name="chat_bubble_time_edited">%1$s, edited</string>
    <!-- A reply quote in the description: %1$s is the replied message's sender, %2$s its text. -->
    <string name="chat_bubble_reply">Reply to %1$s: %2$s</string>
    <!-- A reaction in the description: %1$s is the emoji, %2$d how often it was added. -->
    <string name="chat_bubble_reaction">%1$s %2$d</string>
    <string name="chat_bubble_spoiler">spoiler</string>
    <string name="chat_status_pending">sending</string>
    <string name="chat_status_failed">not sent</string>
    <string name="chat_status_sent">sent</string>
    <string name="chat_status_read">read</string>
    <string name="chat_reaction_custom_emoji">custom emoji</string>
    <string name="chat_reaction_paid">Star</string>
    <plurals name="chat_unread_count">
        <item quantity="one">%d unread message</item>
        <item quantity="other">%d unread messages</item>
    </plurals>

    <!-- Composer (ChatBottomBar) -->
    <!-- The hint in the empty text field. -->
    <string name="composer_placeholder">Message</string>
    <string name="composer_send">Send</string>
    <!-- The button that opens the menu of other ways to send. -->
    <string name="composer_send_options">More send options</string>
    <string name="composer_send_silently">Send without sound</string>
    <string name="composer_schedule">Schedule message</string>
    <!-- Instead of the composer, where the user may not write. -->
    <string name="composer_restricted">You can\'t send messages in this chat</string>
    <string name="composer_not_member">You\'re not a member of this group</string>
    <!-- Formatting of selected text, in the text selection menu. -->
    <string name="composer_format_bold">Bold</string>
    <string name="composer_format_italic">Italic</string>
    <string name="composer_format_underline">Underline</string>
    <string name="composer_format_strikethrough">Strikethrough</string>
    <string name="composer_format_monospace">Monospace</string>
    <string name="composer_format_spoiler">Spoiler</string>
    <string name="composer_format_link">Link</string>
    <!-- The dialog that links the selected text to a web address. -->
    <string name="composer_link_title">Add link</string>
    <string name="composer_link_edit_title">Edit link</string>
    <string name="composer_link_address">Address</string>
    <string name="composer_link_save">Save</string>
    <string name="composer_link_remove">Remove</string>
    <string name="composer_cancel">Cancel</string>
    <!-- The dialog that picks when a scheduled message is sent: a date, then a time. -->
    <string name="composer_schedule_next">Next</string>
    <string name="composer_schedule_back">Back</string>
    <string name="composer_schedule_confirm">Schedule</string>
    <string name="composer_schedule_past">Choose a time in the future</string>
    <!-- A snackbar after scheduling: %1$s is the date and time it will be sent, "Oct 19, 9:41 AM". -->
    <string name="composer_scheduled">Message scheduled for %1$s</string>
    <!-- The bar above the text field while replying: its close button. -->
    <string name="composer_reply_cancel">Cancel reply</string>
    <!-- The bar above the text field while editing a message: its title and close button. -->
    <string name="composer_edit_title">Editing</string>
    <string name="composer_edit_cancel">Cancel editing</string>
    <!-- The button that saves an edited message, in place of the send button. -->
    <string name="composer_edit_save">Save changes</string>
    <!-- What tapping the reply or edit bar does, for screen readers: scroll to its message. -->
    <string name="composer_bar_show">Show message</string>

    <!-- Attach menu (the composer's attach button) -->
    <string name="attach">Attach</string>
    <string name="attach_gallery">Gallery</string>
    <string name="attach_camera">Camera</string>
    <string name="attach_file">File</string>
    <string name="attach_contact">Contact</string>
    <string name="attach_poll">Poll</string>
    <!-- The button of the attach menu that shows the options that do not fit. -->
    <string name="attach_more">More options</string>
    <!-- Snackbars when no app on the device opens for an attach option. -->
    <string name="attach_no_camera_app">No camera app found</string>
    <string name="attach_no_picker_app">No app found to pick that</string>
    <!-- The title of the preview of picked items before they are sent. -->
    <plurals name="attach_preview_photos">
        <item quantity="one">%d photo</item>
        <item quantity="other">%d photos</item>
    </plurals>
    <plurals name="attach_preview_videos">
        <item quantity="one">%d video</item>
        <item quantity="other">%d videos</item>
    </plurals>
    <!-- Photos and videos together, or items still being prepared. -->
    <plurals name="attach_preview_items">
        <item quantity="one">%d item</item>
        <item quantity="other">%d items</item>
    </plurals>
    <plurals name="attach_preview_files">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>
    <!-- The hint in the empty caption field of the preview. -->
    <string name="attach_caption">Add a caption</string>
    <!-- Screen readers: an item of the preview. %1$d is its place, %2$d how many there are. -->
    <string name="attach_item_photo">Photo %1$d of %2$d</string>
    <!-- %3$s is the video's length, "0:42". -->
    <string name="attach_item_video">Video %1$d of %2$d, %3$s</string>
    <string name="attach_item_preparing">Preparing item %1$d of %2$d</string>
    <!-- A file among photos and videos: %1$s is its name. -->
    <string name="attach_item_file">File %1$s</string>
    <!-- The remove button of an item of the preview: %1$s is the item, "Photo 2 of 3" or a file's name. -->
    <string name="attach_remove">Remove %1$s</string>
    <!-- The button over a photo, video or file being sent that stops sending it. -->
    <string name="attach_cancel_upload">Cancel upload</string>

    <!-- The form of a new poll -->
    <string name="poll_title">New poll</string>
    <string name="poll_question">Question</string>
    <string name="poll_options">Options</string>
    <!-- An answer option's field: %1$d is its number. -->
    <string name="poll_option">Option %1$d</string>
    <string name="poll_option_repeated">This option is already there</string>
    <string name="poll_add_option">Add an option</string>
    <string name="poll_remove_option">Remove option %1$d</string>
    <!-- Screen readers: the radio button that marks option %1$d as the quiz's correct answer. -->
    <string name="poll_correct_option">Option %1$d is the correct answer</string>
    <string name="poll_choose_correct">Choose the correct answer</string>
    <string name="poll_settings">Settings</string>
    <string name="poll_anonymous">Anonymous voting</string>
    <string name="poll_anonymous_channel">Polls in channels are always anonymous</string>
    <string name="poll_multiple">Multiple answers</string>
    <string name="poll_quiz">Quiz mode</string>
    <string name="poll_quiz_note">One answer is correct, and votes can\'t be changed</string>

    <!-- Message actions (the sheet a long press opens) -->
    <!-- What a long press on a message does, for screen readers; also their action that opens the sheet. -->
    <string name="message_actions">Message actions</string>
    <!-- Sends a message that failed to send again. -->
    <string name="message_action_resend">Send again</string>
    <string name="message_action_reply">Reply</string>
    <string name="message_action_copy">Copy text</string>
    <!-- Opens the forward sheet, to send the message on to other chats. -->
    <string name="message_action_forward">Forward</string>
    <string name="message_action_edit">Edit</string>
    <string name="message_action_pin">Pin</string>
    <!-- Pins a message of a private chat for the user alone; the other person does not see it pinned. -->
    <string name="message_action_pin_for_self">Pin only for me</string>
    <string name="message_action_unpin">Unpin</string>
    <string name="message_action_delete">Delete</string>
    <!-- Screen readers: what a quick reaction or a reaction under a message does; %1$s is the emoji. -->
    <string name="message_reaction_add">React with %1$s</string>
    <string name="message_reaction_remove">Remove reaction %1$s</string>
    <!-- Screen readers: how often a reaction on the message was added, after what tapping it does. -->
    <plurals name="message_reaction_count">
        <item quantity="one">%1$s, %2$d reaction</item>
        <item quantity="other">%1$s, %2$d reactions</item>
    </plurals>
    <!-- The button at the end of the quick reactions that opens every reaction (the reactions picker). -->
    <string name="message_reactions_more">More reactions</string>
    <!-- Screen readers: opens every reaction of a message, as its "+N" badge does. -->
    <string name="message_reactions_all">All reactions</string>
    <!-- The title of the reactions picker in the message actions sheet. -->
    <string name="reaction_picker_title">Reactions</string>
    <!-- The reactions picker's back button: back to the quick reactions and the message actions. -->
    <string name="reaction_picker_back">Back to message actions</string>
    <!-- Reactions picker sections: the reactions already on the message, those most used in the chat, those the user
         used recently, and those most used on Telegram. -->
    <string name="reaction_picker_on_message">On this message</string>
    <string name="reaction_picker_top">Frequently used</string>
    <string name="reaction_picker_recent">Recently used</string>
    <string name="reaction_picker_popular">Popular</string>
    <!-- The label of a copied message text on the clipboard. -->
    <string name="message_copy_label">Message text</string>
    <!-- A snackbar after copying a message's text, before Android 13, which confirms copies itself. -->
    <string name="message_copied">Text copied</string>
    <!-- A snackbar when an action is no longer allowed for a message, e.g. the time to edit it ran out. -->
    <string name="message_action_unavailable">That isn\'t possible for this message any more</string>
    <!-- The confirmation before a message is deleted. -->
    <string name="message_delete_title">Delete message?</string>
    <!-- The same for the photos and videos of an album, deleted together: %d is how many. -->
    <plurals name="message_delete_title_many">
        <item quantity="one">Delete %d message?</item>
        <item quantity="other">Delete %d messages?</item>
    </plurals>
    <string name="message_delete_for_me_body">This deletes it only for you.</string>
    <string name="message_delete_for_everyone_body">This deletes it for everyone in this chat.</string>
    <!-- When the user may also delete it for the others, with the check box below. -->
    <string name="message_delete_choice_body">This deletes it for you.</string>
    <!-- The check box in a private chat: %1$s is the other person's name. -->
    <string name="message_delete_also_for">Also delete for %1$s</string>
    <!-- The check box in a group. -->
    <string name="message_delete_for_everyone">Delete for everyone</string>
    <string name="message_delete_confirm">Delete</string>
    <string name="message_delete_cancel">Cancel</string>

    <!-- The forward sheet: the chats a message can be forwarded to -->
    <!-- Its title when one message (or an album as one) is forwarded. -->
    <string name="forward_title">Forward to</string>
    <!-- Its title for several messages: %d is how many. -->
    <plurals name="forward_title_many">
        <item quantity="one">Forward %d message to</item>
        <item quantity="other">Forward %d messages to</item>
    </plurals>
    <!-- Below the title once chats are picked: %d is how many. -->
    <plurals name="forward_selected">
        <item quantity="one">%d chat selected</item>
        <item quantity="other">%d chats selected</item>
    </plurals>
    <string name="forward_search">Search chats</string>
    <string name="forward_search_clear">Clear search</string>
    <!-- When the user can send messages in none of their chats. -->
    <string name="forward_no_chats">No chats to forward to</string>
    <!-- When the search finds no chat the messages can go to. -->
    <string name="forward_nothing_found">No chats found</string>
    <!-- The switch that sends copies, without "Forwarded from". -->
    <string name="forward_hide_sender">Hide sender\'s name</string>
    <!-- The switch that leaves the captions of photos, videos and files out. -->
    <string name="forward_hide_captions">Hide captions</string>
    <!-- The field for a message sent before the forwarded ones. -->
    <string name="forward_comment">Add a comment</string>
    <string name="forward_send">Send</string>
    <!-- Screen readers: the send button, with %d the number of chats picked. -->
    <plurals name="forward_send_description">
        <item quantity="one">Send to %d chat</item>
        <item quantity="other">Send to %d chats</item>
    </plurals>
    <!-- Snackbars after forwarding: to %d chats, to the one chat named %1$s, and the action that opens it. -->
    <plurals name="forward_done">
        <item quantity="one">Forwarded to %d chat</item>
        <item quantity="other">Forwarded to %d chats</item>
    </plurals>
    <string name="forward_done_to">Forwarded to %1$s</string>
    <string name="forward_open_chat">Open</string>
    <!-- A snackbar when forwarding to some of the chats failed: %1$d is how many, %2$s says why. -->
    <plurals name="forward_failed_some">
        <item quantity="one">Not forwarded to %1$d chat. %2$s</item>
        <item quantity="other">Not forwarded to %1$d chats. %2$s</item>
    </plurals>
</resources>
