<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chat list (ChatListScreen) -->
    <string name="chat_list_title" translatable="false">Pingogram</string>
    <!-- The connection pill under the title while not connected. -->
    <string name="chat_list_waiting_for_network">Waiting for network…</string>
    <string name="chat_list_connecting_to_proxy">Connecting to proxy…</string>
    <string name="chat_list_connecting">Connecting…</string>
    <string name="chat_list_updating">Updating…</string>
    <string name="chat_list_loading">Loading chats</string>
    <!-- The folder tab of the main chat list. -->
    <string name="chat_list_all_chats">All chats</string>
    <string name="chat_list_empty_title">No chats yet</string>
    <string name="chat_list_empty_body">When you start a conversation or join a group, it shows up here.</string>
    <string name="chat_list_folder_empty_title">No chats in this folder</string>
    <string name="chat_list_folder_empty_body">Chats that belong to this folder show up here.</string>
    <string name="chat_list_error_title">Your chats couldn\'t be loaded</string>
    <string name="chat_list_retry">Try again</string>

    <!-- Rows of the chat list (ChatListItem) -->
    <!-- Before the preview of a message in a group: %1$s is "You" or the sender's first name. -->
    <string name="chat_list_sender">%1$s:</string>
    <!-- Before the preview of a message the user started and did not send. -->
    <string name="chat_list_draft">Draft:</string>
    <!-- Warning badges after the name of a chat that many users reported. -->
    <string name="chat_list_badge_scam">Scam</string>
    <string name="chat_list_badge_fake">Fake</string>
    <!-- An unread count in a badge. -->
    <string name="chat_list_unread_count">%1$d</string>
    <!-- An unread count above the badge's limit: %1$d is the limit, 999. -->
    <string name="chat_list_unread_overflow">%1$d+</string>

    <!-- What screen readers say for a row, after the chat's name. -->
    <string name="chat_list_a11y_verified">Verified</string>
    <string name="chat_list_a11y_secret">Secret chat</string>
    <string name="chat_list_a11y_online">Online</string>
    <string name="chat_list_a11y_muted">Muted</string>
    <string name="chat_list_a11y_pinned">Pinned</string>
    <string name="chat_list_a11y_pending">Sending</string>
    <string name="chat_list_a11y_failed">Not sent</string>
    <string name="chat_list_a11y_sent">Sent</string>
    <string name="chat_list_a11y_read">Read</string>
    <string name="chat_list_a11y_marked_unread">Marked as unread</string>
    <string name="chat_list_a11y_mention">Unread mention</string>
    <string name="chat_list_a11y_reaction">Unread reaction</string>
    <plurals name="chat_list_a11y_unread">
        <item quantity="one">%d unread message</item>
        <item quantity="other">%d unread messages</item>
    </plurals>
    <!-- A folder tab for screen readers: %1$s is its name, %2$s its unread chats ("2 unread chats"). -->
    <string name="chat_list_a11y_tab">%1$s, %2$s</string>
    <plurals name="chat_list_a11y_unread_chats">
        <item quantity="one">%d unread chat</item>
        <item quantity="other">%d unread chats</item>
    </plurals>

    <!-- Actions on a chat (ChatRowAction): screen reader actions on a row, the selection toolbar's buttons. -->
    <string name="chat_list_action_mark_read">Mark as read</string>
    <string name="chat_list_action_mark_unread">Mark as unread</string>
    <string name="chat_list_action_archive">Archive</string>
    <string name="chat_list_action_unarchive">Unarchive</string>
    <string name="chat_list_action_pin">Pin</string>
    <string name="chat_list_action_unpin">Unpin</string>
    <string name="chat_list_action_mute">Mute</string>
    <string name="chat_list_action_unmute">Unmute</string>
    <string name="chat_list_action_delete">Delete</string>
    <!-- Revealed behind a row while it is swiped to mark it as read or unread. -->
    <string name="chat_list_swipe_read">Read</string>
    <string name="chat_list_swipe_unread">Unread</string>
    <!-- Snackbars after archiving: one chat, or %d chats. -->
    <string name="chat_list_archived_one">Chat archived</string>
    <plurals name="chat_list_archived_many">
        <item quantity="one">%d chat archived</item>
        <item quantity="other">%d chats archived</item>
    </plurals>
    <string name="chat_list_undo">Undo</string>

    <!-- Selection mode: the title with the number of selected chats, and the button that leaves it. -->
    <plurals name="chat_list_selected">
        <item quantity="one">%d selected</item>
        <item quantity="other">%d selected</item>
    </plurals>
    <string name="chat_list_clear_selection">Clear selection</string>
    <!-- What long-pressing a row does, for screen readers ("Double-tap and hold to select"). -->
    <string name="chat_list_select">Select</string>

    <!-- Deleting chats (DeleteChatDialog). %1$s is the chat's name. -->
    <string name="chat_list_delete_title">Delete chat?</string>
    <string name="chat_list_leave_group_title">Leave group?</string>
    <string name="chat_list_leave_channel_title">Leave channel?</string>
    <plurals name="chat_list_delete_chats_title">
        <item quantity="one">Delete %d chat?</item>
        <item quantity="other">Delete %d chats?</item>
    </plurals>
    <string name="chat_list_delete_body">%1$s will be removed from your chat list.</string>
    <string name="chat_list_leave_body">You\'ll leave %1$s, and it will be removed from your chat list.</string>
    <string name="chat_list_delete_chats_body">They will be removed from your chat list, and you\'ll leave the groups and channels among them.</string>
    <string name="chat_list_delete_for_user">Also delete for %1$s</string>
    <string name="chat_list_delete_for_members">Delete for all members</string>
    <string name="chat_list_delete_for_subscribers">Delete for all subscribers</string>
    <string name="chat_list_delete_confirm">Delete</string>
    <string name="chat_list_leave_confirm">Leave</string>
    <string name="chat_list_cancel">Cancel</string>

    <!-- The archive (FR-L3, FR-L9): its row at the top of the chat list, and its screen. -->
    <string name="chat_list_archived_chats">Archived chats</string>
    <!-- The archive row's second line before its chats are loaded: how many chats it has. -->
    <plurals name="chat_list_archive_chat_count">
        <item quantity="one">%d chat</item>
        <item quantity="other">%d chats</item>
    </plurals>
    <string name="chat_list_archive_back">Back</string>
    <string name="chat_list_archive_empty_title">No archived chats</string>
    <string name="chat_list_archive_empty_body">Chats you archive show up here, out of your way.</string>

    <!-- Global search (SearchScreen, FR-L6): the search field. -->
    <string name="search_placeholder">Search chats, people and messages</string>
    <string name="search_back">Back</string>
    <string name="search_clear">Clear search</string>
    <!-- Section headers. -->
    <string name="search_section_people">People</string>
    <string name="search_section_recent">Recent</string>
    <string name="search_section_chats">Chats</string>
    <string name="search_section_contacts">Contacts</string>
    <!-- Public chats, channels and users found by username, outside the user's chats and contacts. -->
    <string name="search_section_global">Global search</string>
    <string name="search_section_messages">Messages</string>
    <!-- Recent searches: the button that empties them, and the button that removes one (%1$s is its name). -->
    <string name="search_clear_recents">Clear all</string>
    <string name="search_remove_recent">Remove %1$s from recent searches</string>
    <!-- The second line of a result: a username, or how many members or subscribers ("1,204"). -->
    <string name="search_username" translatable="false">\@%1$s</string>
    <plurals name="search_members">
        <item quantity="one">%1$s member</item>
        <item quantity="other">%1$s members</item>
    </plurals>
    <plurals name="search_subscribers">
        <item quantity="one">%1$s subscriber</item>
        <item quantity="other">%1$s subscribers</item>
    </plurals>
    <!-- Before anything is typed, without recent searches. -->
    <string name="search_hint_title">Find anything</string>
    <string name="search_hint_body">Search your chats and contacts, public channels and groups by their username, and the messages in all your chats.</string>
    <!-- A query that found nothing: %1$s is the query. -->
    <string name="search_no_results_title">No results for “%1$s”</string>
    <string name="search_no_results_body">Check the spelling, or try other words.</string>
    <string name="search_retry">Try again</string>
    <!-- A section that is still searching, for screen readers. -->
    <string name="search_searching">Searching…</string>
    <!-- How many results a query found, announced to screen readers once every section has searched. -->
    <plurals name="search_a11y_results">
        <item quantity="one">%d result</item>
        <item quantity="other">%d results</item>
    </plurals>
    <string name="search_a11y_no_results">No results</string>

    <!-- The request to allow notifications above the chat list (Android 13+). -->
    <string name="notification_prompt_title">Turn on notifications</string>
    <string name="notification_prompt_body">Get notified about new messages and calls. You can mute chats any time.</string>
    <string name="notification_prompt_blocked_title">Notifications are off</string>
    <string name="notification_prompt_blocked_body">To get notified about new messages and calls, allow notifications for Pingogram in your device settings.</string>
    <string name="notification_prompt_not_now">Not now</string>
    <string name="notification_prompt_allow">Allow</string>
    <string name="notification_prompt_open_settings">Open settings</string>
    <!-- Starting a chat (FR-L7): the Chats tab's button and its empty state's, and the New chat screen. -->
    <string name="new_chat">New chat</string>
    <string name="new_chat_back">Back</string>
    <string name="new_chat_group">New group</string>
    <string name="new_chat_channel">New channel</string>
    <string name="new_chat_contact">New contact</string>
    <!-- After tapping New group, New channel or New contact, which a later milestone adds. -->
    <string name="new_chat_not_available">Coming in a later version</string>
    <string name="new_chat_contacts">Contacts</string>
    <string name="new_chat_loading">Loading contacts</string>
    <string name="new_chat_no_contacts">No contacts yet. People you add to your contacts show up here.</string>
</resources>
