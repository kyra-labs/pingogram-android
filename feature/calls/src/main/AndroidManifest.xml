<?xml version="1.0" encoding="utf-8"?>
<!-- Calls (REQUIREMENTS.md FR-V1, docs/adr/0018-calls-and-telecom.md). The permissions they need are declared, with
     their reasons, in :app's manifest, the one place that lists them (AppManifestTest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The call screen: its own task (it never shows the chats), over the lock screen while a call rings or goes
             on (setShowWhenLocked), out of the recent apps. Opened by the app, the call's notifications and Telecom
             only, so not exported. A video call goes on in picture-in-picture when the user leaves it; resizing into
             and out of it is a configuration change the screen handles itself, so the video does not stop. -->
        <activity
            android:name=".ui.CallActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="dev.kyralabs.pingogram.calls" />

        <!-- The voice chat's screen (docs/adr/0023-group-voice-chats-and-live-streams.md): in the call screen's task, out
             of the recent apps, opened by the app and the voice chat's notification only. A live stream goes on in
             picture-in-picture when the user leaves it. -->
        <activity
            android:name=".ui.GroupCallActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="dev.kyralabs.pingogram.calls" />

        <!-- Keeps the app running during a call: phoneCall while it rings, microphone too once the user talks, camera
             while the user's camera sends video, mediaProjection while the user shares the screen. -->
        <service
            android:name=".service.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera|mediaProjection" />

        <!-- "Decline" and "Hang up" of the call's notification, "Leave" of a voice chat's. -->
        <receiver
            android:name=".service.CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
