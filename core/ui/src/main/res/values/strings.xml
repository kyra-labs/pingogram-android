    <!-- Contacts sync (core:ui contactsync), on the Contacts tab and in Settings → Privacy and security. What it sends
         and when must stay honest: the phone's names and numbers go to Telegram, which finds who uses it. -->
    <string name="contact_sync_rationale_title">Find your contacts on Telegram</string>
    <string name="contact_sync_rationale_what">The names and phone numbers of your phone\'s contacts are sent to Telegram, which finds who of them uses Telegram and adds them to your Telegram contacts. This is Telegram\'s own contact import, the same as in Telegram\'s apps.</string>
    <string name="contact_sync_rationale_when">Pingogram reads your contacts only when you turn this on, when you open Contacts while it\'s on, and when you tap Sync now. It never reads them in the background, and keeps no copy.</string>
    <string name="contact_sync_rationale_off">You can turn it off any time in Settings, Privacy and security. Telegram then deletes the phone numbers it imported. People already in your Telegram contacts stay there.</string>
    <string name="contact_sync_not_now">Not now</string>
    <string name="contact_sync_continue">Continue</string>
    <string name="contact_sync_turn_off_title">Turn off contacts sync?</string>
    <string name="contact_sync_turn_off_text">Telegram will delete the phone numbers it imported from your phone. People already in your Telegram contacts stay there.</string>
    <string name="contact_sync_turn_off">Turn off</string>
    <string name="contact_sync_cancel">Cancel</string>
    <string name="contact_sync_turned_off">Contacts sync is off. You can also take back access to your contacts in Android\'s settings.</string>
    <string name="contact_sync_settings">Settings</string>
